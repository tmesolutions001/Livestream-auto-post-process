# Copy to `.env` (same folder) and fill in. Every key is optional; the
# defaults live in podcast_automation/config.py. Environment variables override this file.

# ---- Folders (TODO) ------------------------------------------------------
STAGING_DIR=~/Desktop/Podcast_Staging
ARCHIVE_DIR=~/Desktop/Podcast_Archive
# THUMBNAIL_DIR=~/Desktop/Podcast_Staging         # defaults to STAGING_DIR
# RENDER_OUTPUT_DIR=~/Desktop/Podcast_Staging     # defaults to STAGING_DIR
# WORK_DIR=~/Desktop/Podcast_Staging/_work
# LOG_DIR=./logs

# ---- Edit ---------------------------------------------------------------
FADE_IN_SECONDS=1.0
FADE_OUT_SECONDS=2.0
INTRO_OVERLAP_SECONDS=1.0
VIDEO_FADE_MODE=fusion        # fusion | none
AUDIO_FADE_MODE=ffmpeg        # ffmpeg | none
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg   # full path if Resolve can't find ffmpeg on PATH
# RESOLVE_PROJECT_NAME=Podcast          # blank = use the project currently open

# ---- Render ---------------------------------------------------------------
MP4_RENDER_CODEC=H264         # e.g. H264_NVIDIA for NVENC
MP3_AUDIO_BITRATE_KBPS=192

# ---- Custom MP3 endpoint (TODO) -------------------------------------------
CUSTOM_API_ENABLED=true
CUSTOM_API_URL=
CUSTOM_API_TOKEN=
# CUSTOM_API_FILE_FIELD=file

# ---- YouTube (TODO) -------------------------------------------------------
YOUTUBE_ENABLED=true
# YOUTUBE_CLIENT_SECRETS_FILE=./credentials/client_secret.json
# YOUTUBE_TOKEN_FILE_EN=./credentials/youtube_token_EN.json
# YOUTUBE_TOKEN_FILE_ES=./credentials/youtube_token_ES.json
# YOUTUBE_CATEGORY_ID=22
# YOUTUBE_TAGS=podcast,interview

# ---- Safety ---------------------------------------------------------------
DRY_RUN_UPLOADS=true          # set to false once the API settings above are filled in
ARCHIVE_ENABLED=true
